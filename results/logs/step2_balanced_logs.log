80    /*=======SECOM_BALANCED=============*/
81    /* 計算兩類筆數 */
82    proc sql noprint;
83    select count(*) into :n1  from work.secom_cleaned where Label=1;
84    select count(*) into :n_1 from work.secom_cleaned where Label=-1;
85    quit;
NOTE: PROCEDURE SQL used (Total process time):
      real time           0.00 秒
      cpu time            0.00 秒
      
86    
87    /* 這裡假設 Label=1 為少數類 → 目標樣本數 = &n1 */
88    %let target=&n1;
89    
90    /* 分成少數類 / 多數類 */
91    data pos neg;
92    set work.secom_cleaned;
93    if Label=1  then output pos;
94    else if Label=-1 then output neg;
95    run;
NOTE: There were 1567 observations read from the data set WORK.SECOM_CLEANED.
