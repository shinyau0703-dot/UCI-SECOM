100   
101   data _s;
102   set work.secom(rename=(&rename_list));
103   
104   Label='Pass/Fail'n;
105   drop 'Pass/Fail'n;
106   
107   /*前處理→datetime/衍生欄位*/
108   length Time_dt 8;  /*修改日期格式*/
109   if vtype(Time)='C' then Time_dt=input(strip(Time),anydtdtm.);
110   else if vtype(Time)='N' then Time_dt=Time;
111   format Time_dt datetime20.;
112   
113   Date_part=datepart(Time_dt);
114   Hour_part=hour(Time_dt);
115   Quarter_num=qtr(Date_part);
116   DOW_num=weekday(Date_part);
117   
118   length Shift $2 Quarter $2 IsWeekend $1 DOW $3;
119   
120   /* 班別：S1=日班(8–15), S2=小夜(16–23), S3=大夜(0–7) */
121   if 8<=Hour_part<16 then Shift='S1';
122   else if 16<=Hour_part<24 then Shift='S2';
123   else Shift='S3';
124   
125   /* 季別：Q1–Q4 */
126   if 1<=Quarter_num<=4 then Quarter=cats('Q',Quarter_num);
127   
128   /* 星期：D1–D7 */
129   if 1<=DOW_num<=7 then DOW=cats('D',DOW_num);
130   
131   /* 是否週末：1=週末(六日), 0=平日 */
132   if DOW_num in(1,7) then IsWeekend='1';
133   else IsWeekend='0';
134   
135   /* 清掉中間用不到的欄位；Time_dt 取代 Time */
136   drop Time Date_part Hour_part Quarter_num DOW_num;
137   rename Time_dt=Time;
138   run;
